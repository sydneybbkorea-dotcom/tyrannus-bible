rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 사용자 개인 데이터 — 본인만 접근
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // 타자연습 랭킹 — 누구나 읽기, 로그인 사용자만 쓰기
    match /typing-rankings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // 공유 — 허용 이메일 ACL 적용, 소유자만 생성/수정/삭제
    match /shares/{shareCode} {
      allow read: if request.auth != null
        && (
          resource.data.ownerUid == request.auth.uid
          || resource.data.allowedEmails.size() == 0
          || request.auth.token.email in resource.data.allowedEmails
        );
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
    // 라이브 강의 세션
    match /sessions/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewerCount'])
      );
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
  }
}
